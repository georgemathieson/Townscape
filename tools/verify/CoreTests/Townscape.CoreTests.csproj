<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the engine-free code (state + generation) and its EditMode tests outside Unity.
    Unity ignores this folder; it is only for quick checks in CI or a terminal:
      dotnet test tools/verify/CoreTests
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/Townscape/Scripts/State/**/*.cs" />
    <Compile Include="../../../Assets/Townscape/Scripts/Generation/**/*.cs" />
    <Compile Include="../../../Assets/Townscape/Scripts/Simulation/**/*.cs" />
    <Compile Include="../../../Assets/Townscape/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
  </ItemGroup>
</Project>
