<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Townscape.Editor</AssemblyName>
    <UsesUnity>true</UsesUnity>
    <UsesUnityEditor>true</UsesUnityEditor>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ScriptsRoot)Editor/**/*.cs" />
    <ProjectReference Include="State.csproj" />
    <ProjectReference Include="Generation.csproj" />
    <ProjectReference Include="Simulation.csproj" />
    <ProjectReference Include="CoffeeShop.csproj" />
    <ProjectReference Include="Runtime.csproj" />
    <ProjectReference Include="Stubs.csproj" />
    <!-- Not a real reference: it just builds the tests along with everything else. -->
    <ProjectReference Include="Tests.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
